{
  "name": "playwright-typescript-automation",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "allChecks": "tsc --noEmit && prettier . --check && eslint . && pnpm run knip",
    "allureReport": "node ./utils/generate-allure-report.mjs",
    "check-style": "prettier . --check",
    "clean": "rimraf ./out",
    "commitlint": "commitlint",
    "format": "prettier . --write",
    "knip": "knip",
    "lint": "eslint .",
    "lint-staged": "lint-staged",
    "pretest": "tsc --noEmit",
    "prepare": "husky",
    "test": "playwright test"
  },
  "keywords": [],
  "author": "fifernandez",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "^26",
    "pnpm": ">=12.15.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "ajv": "8.20.0",
    "allure": "3.33.0",
    "allure-playwright": "3.14.0",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "husky": "9.1.7",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "ortoni-report": "4.10.0",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,cjs,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "knip": {
    "ignore": [
      "allurerc.mjs",
      "reports-indexer/**",
      "utils/generate-allure-report.mjs"
    ]
  }
}
