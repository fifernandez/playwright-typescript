{
  "name": "playwright-typescript-automation",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "allChecks": "tsc --noEmit && prettier . --check && eslint . && npm run knip",
    "allureReport": "node ./utils/generate-allure-report.mjs",
    "check-style": "prettier . --check",
    "clean": "rimraf ./out",
    "format": "prettier . --write",
    "knip": "knip",
    "lint": "eslint .",
    "pretest": "tsc --noEmit",
    "prepare": "husky",
    "test": "playwright test"
  },
  "keywords": [],
  "author": "fifernandez",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=11.10.0"
  },
  "overrides": {
    "@humanfs/node": "^0.16.8",
    "@tootallnate/once": "^3.0.1",
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.9",
    "minimatch": "^10.2.5",
    "qs": "^6.16.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "ajv": "8.20.0",
    "allure": "3.22.1",
    "allure-playwright": "3.14.0",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "ortoni-report": "4.10.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "knip": {
    "ignore": [
      "allurerc.mjs",
      "reports-indexer/**",
      "utils/generate-allure-report.mjs"
    ]
  }
}
