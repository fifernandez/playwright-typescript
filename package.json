{
  "name": "playwright-typescript-automation",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "allChecks": "tsc --noEmit && prettier . --check && eslint . && npm run knip",
    "allureReport": "rimraf ./out/reports/allure && allure generate ./out/results/allure && allure open ./out/reports/allure",
    "check-style": "prettier . --check",
    "clean": "rimraf ./out",
    "format": "prettier . --write",
    "knip": "knip",
    "lint": "eslint .",
    "pretest": "tsc --noEmit",
    "prepare": "husky",
    "test": "playwright test"
  },
  "keywords": [],
  "author": "fifernandez",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=11.10.0"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "adm-zip": "^0.6.0",
    "minimatch": "^10.2.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@playwright/test": "1.61.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "ajv": "8.20.0",
    "allure": "3.14.3",
    "allure-playwright": "3.10.2",
    "dotenv": "17.4.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.10.5",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "ortoni-report": "4.10.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "knip": {
    "ignore": [
      "allurerc.mjs",
      "reports-indexer/**"
    ]
  }
}
